# Set these on Render > Web Service > Environment, not in a public repository.
# The API key previously shared in chat must be revoked, replaced, and NEVER committed.
OPENAI_API_KEY=
DEMO_ACCESS_PASSWORD=replace-with-a-strong-random-password-for-owner
# Optional: separate usernames/passwords for adult school evaluators; these are NOT student logins.
# Each password must be at least 14 characters. For example (change every credential):
DEMO_ACCOUNTS_JSON=[]
# Limit new realtime session attempts per evaluator per day (in-memory reset on server restart).
MAX_DAILY_VOICE_SESSIONS=12
OPENAI_REALTIME_MODEL=gpt-realtime
HOST=127.0.0.1
PORT=3000

# Optional model overrides
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TEXT_MODEL=gpt-5-mini

OPENAI_DEFAULT_VOICE=marin
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# OPTIONAL paid image generation: requires explicit adult approval in the classroom.
ENABLE_LIVE_IMAGES=false
